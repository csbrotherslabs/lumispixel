# LumisPixel example environment configuration.
# Copy to .env for local development and never commit real credentials.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
GALLERY_STORAGE_BACKEND=local
GALLERY_STORAGE_ENVIRONMENT=dev

# Backblaze B2 (required when GALLERY_STORAGE_BACKEND=b2)
# Get the region and S3 endpoint from the B2 bucket details page.
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=lumispixel-production-media
B2_REGION=
B2_ENDPOINT_URL=
B2_SIGNED_URL_TTL=900

# Private media delivery / application services
MEDIA_DELIVERY_BASE_URL=https://media-dev.lumispixel.com
MEDIA_SIGNING_SECRET=
MEDIA_SIGNED_URL_TTL=900
DATABASE_URL=
# Optional PgBouncer transaction endpoint; retain DATABASE_URL for direct access.
DB_TRANSACTION_POOLING=0
DB_POOL_URL=
# Development: release connections after each request. Production default remains 60.
DB_CONN_MAX_AGE=0
# Set a distinct name per web/worker service for pg_stat_activity diagnostics.
DB_APPLICATION_NAME=lumispixel-dev-web
VISUAL_SEARCH_DB_APPLICATION_NAME=lumispixel-dev-vector
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=

# Per-photo upload limit: 150 MB (150 * 1024 * 1024 bytes)
MAX_GALLERY_UPLOAD_BYTES=157286400

# Upload safety: maximum decoded pixels per gallery image (100 MP default)
MAX_GALLERY_IMAGE_PIXELS=100000000

# Non-gallery uploads. Enable only after configuring buckets/Worker and copying files.
USER_UPLOAD_STORAGE_BACKEND=local
B2_SITE_BUCKET_NAME=lumispixel-dev-site-media
B2_PRIVATE_UPLOAD_BUCKET_NAME=lumispixel-dev-private-media
B2_SITE_ACCESS_KEY_ID=
B2_PRIVATE_UPLOAD_ACCESS_KEY_ID=
B2_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=
B2_SITE_SECRET_ACCESS_KEY=
SITE_MEDIA_DELIVERY_BASE_URL=https://site-media-dev.lumispixel.com

# Optional semantic search: web and worker need the same reviewed local model.
VISUAL_SEARCH_SEMANTIC_ENABLED=0
VISUAL_SEARCH_SEMANTIC_POLICY_APPROVED=0
VISUAL_SEARCH_SEMANTIC_MODEL_PATH=
VISUAL_SEARCH_SEMANTIC_MODEL_VERSION=clip-v1

# Durable transactional email (SMTP remains default; API opt-in after validation)
TRANSACTIONAL_EMAIL_TRANSPORT=smtp
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=
# Comma-separated Fernet keys, newest first; required for sensitive email.
# Generate locally: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_PAYLOAD_KEYS=
# ISO 8601 timezone-aware rollout cutoff; blank disables historical inference.
EMAIL_RECONCILIATION_START=
# General accepted payload purge is disabled until policy approval.
EMAIL_TERMINAL_PAYLOAD_RETENTION_DAYS=0

# Local automated PostgreSQL tests (never use managed database credentials).
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=lumispixel_local
TEST_DB_USER=lumispixel_test
TEST_DB_PASSWORD=
