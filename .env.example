# LumisPixel example environment configuration.
# Copy to .env for local development and never commit real credentials.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
GALLERY_STORAGE_BACKEND=local
GALLERY_STORAGE_ENVIRONMENT=dev

# Backblaze B2 (required when GALLERY_STORAGE_BACKEND=b2)
# Get the region and S3 endpoint from the B2 bucket details page.
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=lumispixel-production-media
B2_REGION=
B2_ENDPOINT_URL=
B2_SIGNED_URL_TTL=900
