# LumisPixel production deployment contract.
# Every non-commented variable below must be reviewed and supplied by the production environment.
# Never commit real credentials. Production startup intentionally fails on missing/invalid critical infrastructure settings.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=lumispixel.com,www.lumispixel.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://lumispixel.com,https://www.lumispixel.com
DJANGO_PUBLIC_BASE_URL=https://lumispixel.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_STATICFILES_STORAGE=whitenoise.storage.CompressedManifestStaticFilesStorage

# Production PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/DBNAME?sslmode=require
DB_SSL_REQUIRE=1
DB_CONN_MAX_AGE=60

# Amazon SES SMTP credentials (not AWS console credentials).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-with-ses-smtp-user
DJANGO_EMAIL_HOST_PASSWORD=replace-with-ses-smtp-password
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=LumisPixel <noreply@lumispixel.com>
DJANGO_SERVER_EMAIL=LumisPixel <noreply@lumispixel.com>
DJANGO_EMAIL_USE_SSL=0

# Private gallery originals: Backblaze B2 S3-compatible storage.
GALLERY_STORAGE_BACKEND=b2
GALLERY_STORAGE_ENVIRONMENT=prod
B2_ACCESS_KEY_ID=replace-with-b2-application-key-id
B2_SECRET_ACCESS_KEY=replace-with-b2-application-key
B2_BUCKET_NAME=replace-with-private-b2-bucket
B2_REGION=replace-with-b2-region
B2_ENDPOINT_URL=https://s3.REPLACE_REGION.backblazeb2.com
B2_SIGNED_URL_TTL=900
B2_MULTIPART_SIGNED_URL_TTL=900
B2_MULTIPART_STALE_AFTER_SECONDS=86400

# Cloudflare private-media delivery. The Worker must verify the exact HMAC
# contract in apps/galleries/media_delivery.py: HMAC-SHA256("<path>\\n<expires>")
# using this same secret, and reject expired/invalid signatures.
MEDIA_DELIVERY_BASE_URL=https://media.lumispixel.com
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
MEDIA_SIGNED_URL_TTL=900

# Redis / Celery. Use rediss:// when TLS is required by the provider.
CELERY_BROKER_URL=rediss://default:PASSWORD@HOST:25061/0
CELERY_RESULT_BACKEND=rediss://default:PASSWORD@HOST:25061/0
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800
CELERY_VISIBILITY_TIMEOUT=3600
CELERY_RESULT_EXPIRES=86400
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=500

# Per-file upload guardrail. Plan storage allowances are enforced by application plan configuration.
MAX_GALLERY_UPLOAD_BYTES=104857600
MAX_GALLERY_IMAGE_PIXELS=100000000
FREE_STORAGE_LIMIT_BYTES=53687091200

# Gunicorn web process. Tune WEB_CONCURRENCY to the deployed instance's memory/CPU.
WEB_CONCURRENCY=3
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LIMIT_REQUEST_LINE=4094
GUNICORN_LIMIT_REQUEST_FIELDS=100
GUNICORN_LIMIT_REQUEST_FIELD_SIZE=8190
GUNICORN_LOG_LEVEL=info
# Set to the trusted reverse-proxy address/range supplied by the hosting platform.
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
