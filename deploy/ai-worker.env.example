# Edit privately at /srv/lumispixel/.env; never commit the populated file.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY="REPLACE_WITH_PRIVATE_WORKER_SECRET"
DATABASE_URL="REPLACE_WITH_APPLICATION_DATABASE_URL"
DB_SSL_REQUIRE=True
DB_CONN_MAX_AGE=0
VISUAL_SEARCH_DATABASE_URL="REPLACE_WITH_VECTOR_DATABASE_URL_USING_SSLMODE_VERIFY_FULL"
CELERY_BROKER_URL="rediss://REPLACE?ssl_cert_reqs=required&ssl_ca_certs=%2Fsrv%2Flumispixel%2Fcerts%2Fredis-ca.crt"
CELERY_RESULT_BACKEND="rediss://REPLACE?ssl_cert_reqs=required&ssl_ca_certs=%2Fsrv%2Flumispixel%2Fcerts%2Fredis-ca.crt"
GALLERY_STORAGE_BACKEND=b2
GALLERY_STORAGE_ENVIRONMENT=prod
B2_ACCESS_KEY_ID="REPLACE"
B2_SECRET_ACCESS_KEY="REPLACE"
B2_BUCKET_NAME="REPLACE"
B2_REGION="REPLACE"
B2_ENDPOINT_URL="https://REPLACE"
MEDIA_DELIVERY_BASE_URL="https://media.lumispixel.com"
MEDIA_SIGNING_SECRET="REPLACE_WITH_EXISTING_PRODUCTION_MEDIA_SIGNING_SECRET"
CELERY_AI_QUEUES_ENABLED=True
VISUAL_SEARCH_SEMANTIC_MODEL_PATH=/srv/lumispixel/models/clip-vit-base-patch32
VISUAL_SEARCH_SEMANTIC_MODEL_VERSION=clip-v1
VISUAL_SEARCH_SEMANTIC_ENABLED=False
VISUAL_SEARCH_SEMANTIC_POLICY_APPROVED=False
VISUAL_SEARCH_FACE_INDEXING_ENABLED=False
VISUAL_SEARCH_SELFIE_API_ENABLED=False
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
